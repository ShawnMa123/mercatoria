# mercatoria 轻量服务配置
# 复制为 .env 后填入真实值；.env 已在 .gitignore 中。

# 语料与索引
MERCATORIA_CORPUS_DIR=corpus
MERCATORIA_INDEX_DIR=data/index
MERCATORIA_MANIFEST=corpus/manifest.json

# embedding（OpenAI-compatible；当前网关为 1024 维）
EMBEDDING_BASE=http://localhost:3425/v1
EMBEDDING_MODEL=my-team-2k/qwen3.7-text-embedding
EMBEDDING_API_KEY=

# 可选答案生成（不配置则 /v1/ask 只返回检索结果）
LLM_BASE=http://localhost:3425/v1
LLM_MODEL=local-wb/cn:deepseek-v4.1-flash
LLM_API_KEY=
MERCATORIA_ANSWER_ENABLED=true

# 可选：RAGFlow 基线（不再作为运行时依赖）
RAGFLOW_BASE=http://localhost:9380
RAGFLOW_API_KEY=ragflow-your-key-here

# 中文法规原始出处（可选）
# LAWREFBOOK_ROOT=/path/to/Laws
